# Local development
DATABASE_URL=postgresql://postgres:password@localhost:5432/attendance_db
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY=8h
NODE_ENV=development
PORT=4321
# Set COOKIE_SECURE=true only if serving over HTTPS (recommended for production).
# Defaults to true when NODE_ENV=production, false otherwise.
# COOKIE_SECURE=false

# Docker Compose (shared with db service)
DB_PASSWORD=password
