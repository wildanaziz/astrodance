---
export interface Props { title?: string; role?: 'admin' | 'student' | null; }
const { title = 'Attendance System', role } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="theme-color" content="#ffffff" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --color-bg: #fafafa;
      --color-surface: #ffffff;
      --color-text: #09090b;
      --color-muted: #71717a;
      --color-muted-light: #a1a1aa;
      --color-border: #f4f4f5;
      --color-border-strong: #e4e4e7;
      --color-accent: #6366f1;
      --color-accent-hover: #4f46e5;
      --color-accent-wash: #eef2ff;
      --color-success: #10b981;
      --color-success-wash: #ecfdf5;
      --color-warning: #f59e0b;
      --color-warning-wash: #fffbeb;
      --color-danger: #ef4444;
      --color-danger-wash: #fef2f2;
      --radius-xs: 6px;
      --radius-sm: 8px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-xl: 18px;
      --font-display: 'DM Serif Display', Georgia, serif;
      --font-body: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.03);
      --shadow-md: 0 1px 3px 0 rgba(0,0,0,0.04), 0 1px 2px -1px rgba(0,0,0,0.03);
      --shadow-lg: 0 4px 6px -1px rgba(0,0,0,0.04), 0 2px 4px -2px rgba(0,0,0,0.03);
      --shadow-xl: 0 10px 15px -3px rgba(0,0,0,0.05), 0 4px 6px -4px rgba(0,0,0,0.03);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
      -webkit-tap-highlight-color: transparent;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-body);
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      min-height: 100vh;
      font-size: 0.9375rem;
    }

    a { color: inherit; text-decoration: none; }

    button {
      cursor: pointer;
      font-family: var(--font-body);
      font-size: inherit;
    }

    :focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* --- Animations --- */
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade-in {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes scale-in {
      from { opacity: 0; transform: scale(0.97); }
      to   { opacity: 1; transform: scale(1); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      html { scroll-behavior: auto; }
    }

    .anim-fade-up {
      animation: fade-up 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .anim-fade-in {
      animation: fade-in 0.35s ease forwards;
    }
    .anim-scale-in {
      animation: scale-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* --- Cards --- */
    .card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
    }

    /* --- Buttons --- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.6rem 1.35rem;
      border-radius: var(--radius-sm);
      border: none;
      font-weight: 600;
      font-size: 0.875rem;
      line-height: 1.25rem;
      letter-spacing: 0.005em;
      transition: background-color 0.18s ease, box-shadow 0.18s ease, color 0.18s ease, transform 0.12s ease;
      white-space: nowrap;
      touch-action: manipulation;
      position: relative;
      overflow: hidden;
    }
    .btn:active { transform: scale(0.97); }
    .btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
    }

    .btn-primary {
      background: var(--color-accent);
      color: #ffffff;
      box-shadow: 0 1px 2px rgba(99, 102, 241, 0.15), 0 0 0 0 rgba(99, 102, 241, 0);
    }
    .btn-primary:hover:not(:disabled) {
      background: var(--color-accent-hover);
      box-shadow: 0 2px 8px rgba(99, 102, 241, 0.25), 0 0 0 0 rgba(99, 102, 241, 0);
    }
    .btn-primary:focus-visible {
      outline: none;
      box-shadow: 0 2px 8px rgba(99, 102, 241, 0.25), 0 0 0 3px var(--color-accent-wash);
    }

    .btn-secondary {
      background: var(--color-surface);
      color: var(--color-text);
      border: 1px solid var(--color-border-strong);
      box-shadow: var(--shadow-sm);
    }
    .btn-secondary:hover:not(:disabled) {
      background: var(--color-bg);
      border-color: var(--color-muted-light);
      box-shadow: var(--shadow-md);
    }
    .btn-secondary:focus-visible {
      outline: none;
      box-shadow: var(--shadow-md), 0 0 0 3px var(--color-bg);
    }

    .btn-ghost {
      background: transparent;
      color: var(--color-muted);
      font-weight: 500;
      padding: 0.5rem 0.85rem;
    }
    .btn-ghost:hover:not(:disabled) {
      background: var(--color-bg);
      color: var(--color-text);
    }
    .btn-ghost:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px var(--color-bg);
    }

    .btn-sm {
      padding: 0.4rem 0.85rem;
      font-size: 0.8125rem;
      gap: 0.35rem;
    }

    .btn-spinner {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid currentColor;
      border-right-color: transparent;
      border-radius: 50%;
      animation: btn-spin 0.6s linear infinite;
    }
    @keyframes btn-spin {
      to { transform: rotate(360deg); }
    }

    .modal-actions {
      display: flex;
      gap: 0.5rem;
    }
    .modal-actions .btn {
      flex: 1;
    }

    .modal-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      letter-spacing: -0.01em;
      color: var(--color-text);
      line-height: 1.2;
    }
    .modal-subtitle {
      font-size: 0.8125rem;
      color: var(--color-muted);
      margin-top: 0.2rem;
    }

    /* --- Form --- */
    .form-group { margin-bottom: 1rem; }
    .form-label {
      display: block;
      margin-bottom: 0.35rem;
      font-weight: 600;
      font-size: 0.8125rem;
      color: var(--color-muted);
    }
    .form-input,
    .form-select {
      width: 100%;
      padding: 0.6rem 0.8rem;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-sm);
      font-size: 0.9375rem;
      font-family: var(--font-body);
      background: var(--color-surface);
      color: var(--color-text);
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .form-input:focus,
    .form-select:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px var(--color-accent-wash);
    }

    .form-error {
      color: var(--color-danger);
      font-size: 0.8125rem;
      margin-top: 0.3rem;
    }

    /* --- Typography --- */
    .text-display { font-family: var(--font-display); }
    .text-muted { color: var(--color-muted); }
    .text-xs { font-size: 0.75rem; }
    .text-sm { font-size: 0.8125rem; }
    .text-base { font-size: 0.9375rem; }

    /* --- Nav --- */
    .nav {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(255,255,255,0.82);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--color-border);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 3.25rem;
    }
    .nav-brand {
      font-family: var(--font-display);
      font-size: 1.15rem;
      color: var(--color-text);
      letter-spacing: -0.01em;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .nav-links a {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-muted);
      transition: color 0.15s;
    }
    .nav-links a:hover {
      color: var(--color-text);
    }

    /* --- Badges --- */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }
    .badge-success {
      background: var(--color-success-wash);
      color: #065f46;
    }
    .badge-warning {
      background: var(--color-warning-wash);
      color: #92400e;
    }
    .badge-accent {
      background: var(--color-accent-wash);
      color: #4338ca;
    }
    .badge-muted {
      background: var(--color-bg);
      color: var(--color-muted);
    }

    /* --- Tables --- */
    .table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;
    }
    thead th {
      text-align: left;
      padding: 0.7rem 1rem;
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-muted-light);
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg);
    }
    tbody td {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--color-border);
    }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover td { background: var(--color-bg); }

    /* --- Modals --- */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(9,9,11,0.3);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      align-items: center;
      justify-content: center;
      z-index: 50;
      padding: 1rem;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal {
      background: var(--color-surface);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-xl);
      border: 1px solid var(--color-border);
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      animation: scale-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      overscroll-behavior: contain;
    }
    .modal-header {
      padding: 1.5rem 1.75rem 0;
    }
    .modal-body {
      padding: 1rem 1.75rem 1.75rem;
    }

    /* --- Section --- */
    .section-heading {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 400;
      letter-spacing: -0.01em;
      color: var(--color-text);
      line-height: 1.2;
    }

    /* --- Empty State --- */
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--color-muted-light);
    }

    /* --- Live dot --- */
    .live-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-warning);
      margin-right: 0.3rem;
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* --- Radio group --- */
    .radio-group {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .radio-option {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      padding: 0.8rem 0.9rem;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: border-color 0.12s, background-color 0.12s;
      min-height: 44px;
    }
    .radio-option:hover {
      border-color: var(--color-accent);
      background: var(--color-accent-wash);
    }
    .radio-option input[type="radio"] {
      margin-top: 0.15rem;
      width: auto;
      accent-color: var(--color-accent);
    }
    .radio-option .radio-label {
      font-weight: 600;
      font-size: 0.875rem;
      color: var(--color-text);
    }
    .radio-option .radio-desc {
      font-size: 0.8125rem;
      color: var(--color-muted);
      margin-top: 0.1rem;
    }

    /* --- Scrollbar --- */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.12); border-radius: 3px; }

    /* --- Responsive --- */
    @media (max-width: 640px) {
      .container { padding: 0 1rem; }
      .nav-links { gap: 1rem; }
      .modal { border-radius: var(--radius-lg); }
      .modal-header { padding: 1.25rem 1.25rem 0; }
      .modal-body { padding: 0.75rem 1.25rem 1.25rem; }
      .section-heading { font-size: 1.2rem; }
    }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="container nav-inner">
      {role === 'admin' && <a href="/admin/dashboard" class="nav-brand" style="color: var(--color-accent);">Astrodance Admin</a>}
      {role === 'student' && <a href="/student/dashboard" class="nav-brand">Astrodance</a>}
      <div class="nav-links">
        {role === 'admin' && <a href="/admin/dashboard">Admin</a>}
        {role === 'student' && <a href="/student/dashboard">Dashboard</a>}
        {role === 'student' && <a href="/student/attendance">History</a>}
        {!role && <a href="/login">Login</a>}
        {!role && <a href="/register">Register</a>}
        {role && <a href="/logout">Logout</a>}
      </div>
    </div>
  </nav>

  <main class="container" style="padding-top:2rem;padding-bottom:3rem">
    <slot />
  </main>

  <!-- Session Expiry Modal -->
  <div id="expiryModal" class="modal-overlay">
    <div class="modal" style="max-width:360px;text-align:center">
      <div class="modal-body" style="padding-top:1.75rem">
        <h3 style="font-family:var(--font-display);font-size:1.3rem;color:var(--color-danger);margin-bottom:0.5rem">Session Expiring Soon</h3>
        <p style="color:var(--color-muted);margin-bottom:1.25rem">Your session will expire in a few minutes. Please save your work and log in again.</p>
        <button type="button" class="btn btn-primary" style="width:100%" onclick="renewSession()">Continue Session</button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const cookie = document.cookie.split('; ').find(r => r.startsWith('session_expires_at='));
      if (!cookie) return;
      const ms = parseInt(cookie.split('=')[1]);
      if (!ms) return;
      const warnAt = ms - 300000;
      const now = Date.now();
      const delay = Math.max(0, warnAt - now);
      const modal = document.getElementById('expiryModal');
      if (delay === 0 && now < ms) {
        modal.classList.add('active');
      } else if (delay > 0) {
        setTimeout(() => { if (Date.now() < ms) modal.classList.add('active'); }, delay);
      }
      window.renewSession = () => window.location.reload();
    })();
  </script>
</body>
</html>
