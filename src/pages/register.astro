---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Register">
  <div class="auth-wrapper">
    <div class="auth-bg" aria-hidden="true">
      <div class="auth-bg-shape auth-bg-shape--1"></div>
      <div class="auth-bg-shape auth-bg-shape--2"></div>
      <div class="auth-bg-shape auth-bg-shape--3"></div>
    </div>

    <div class="auth-card anim-scale-in">
      <div class="auth-header">
        <h1 class="auth-title" style="color: #03a303;">Create Account</h1>
        <p class="auth-subtitle">Register as a student to join classes</p>
      </div>

      <div id="stateBox" class="state-box hidden" role="alert" aria-live="polite"></div>

      <form id="regForm" class="auth-form" novalidate>
        <div class="form-group">
          <label class="form-label" for="regName">Full Name</label>
          <input type="text" id="regName" name="fullName" class="form-input" placeholder="Your full name" required autocomplete="name" />
          <p class="field-error" id="nameError"></p>
        </div>
        <div class="form-group">
          <label class="form-label" for="regNim">NIM</label>
          <input type="text" id="regNim" name="nim" class="form-input" placeholder="15-digit student ID" required inputmode="numeric" pattern="\d{15}" autocomplete="off" spellcheck="false" />
          <p class="field-error" id="nimError"></p>
        </div>
        <div class="form-group">
          <label class="form-label" for="regEmail">Email</label>
          <input type="email" id="regEmail" name="email" class="form-input" placeholder="you@university.ac.id" required autocomplete="email" spellcheck="false" />
          <p class="field-error" id="emailError"></p>
        </div>
        <div class="form-group">
          <label class="form-label" for="regPassword">Password</label>
          <input type="password" id="regPassword" name="password" class="form-input" placeholder="Minimum 8 characters" required minlength="8" autocomplete="new-password" />
          <p class="field-error" id="passwordError"></p>
        </div>
        <button type="submit" class="btn btn-primary auth-submit" id="submitBtn">Create Account</button>
      </form>

      <div class="auth-footer">
        <span>Already have an account?</span>
        <a href="/login" class="auth-link">Sign in</a>
      </div>
    </div>
  </div>

  <style>
    .auth-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 8rem);
      padding: 2rem 1rem;
      position: relative;
      overflow: hidden;
    }
    .auth-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .auth-bg-shape {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.35;
    }
    .auth-bg-shape--1 {
      width: 500px;
      height: 500px;
      background: var(--color-accent-wash);
      top: -15%;
      left: -10%;
    }
    .auth-bg-shape--2 {
      width: 400px;
      height: 400px;
      background: var(--color-success-wash);
      bottom: -10%;
      right: -8%;
    }
    .auth-bg-shape--3 {
      width: 300px;
      height: 300px;
      background: var(--color-warning-wash);
      top: 35%;
      left: 55%;
    }
    .auth-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 440px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-xl), 0 0 0 1px rgba(0,0,0,0.02);
      padding: 2.25rem 2rem 2rem;
    }
    .auth-header {
      text-align: center;
      margin-bottom: 1.75rem;
    }
    .auth-logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 52px;
      height: 52px;
      border-radius: var(--radius-lg);
      background: var(--color-success-wash);
      color: var(--color-success);
      margin-bottom: 1rem;
    }
    .auth-title {
      font-family: var(--font-display);
      font-size: 1.65rem;
      font-weight: 400;
      letter-spacing: -0.02em;
      color: var(--color-text);
      line-height: 1.2;
    }
    .auth-subtitle {
      color: var(--color-muted);
      font-size: 0.875rem;
      margin-top: 0.35rem;
    }
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .auth-submit {
      width: 100%;
      margin-top: 0.5rem;
      padding: 0.7rem 1.35rem;
      font-size: 0.9375rem;
    }
    .auth-footer {
      text-align: center;
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.8125rem;
      color: var(--color-muted);
    }
    .auth-link {
      color: var(--color-accent);
      font-weight: 600;
      margin-left: 0.25rem;
      transition: color 0.15s;
    }
    .auth-link:hover { color: var(--color-accent-hover); }

    .state-box {
      margin-bottom: 1rem;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.8125rem;
      line-height: 1.5;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .state-box.hidden {
      display: none;
    }
    .state-box--error {
      background: var(--color-danger-wash);
      border: 1px solid rgba(239, 68, 68, 0.15);
      color: var(--color-danger);
    }
    .state-box--success {
      background: var(--color-success-wash);
      border: 1px solid rgba(16, 185, 129, 0.15);
      color: #065f46;
    }
    .state-box--warning {
      background: var(--color-warning-wash);
      border: 1px solid rgba(245, 158, 11, 0.15);
      color: #92400e;
    }

    .field-error {
      color: var(--color-danger);
      font-size: 0.75rem;
      margin-top: 0.3rem;
      min-height: 0;
      transition: opacity 0.15s;
    }
    .field-error:empty { opacity: 0; }

    .form-input.input-error {
      border-color: var(--color-danger);
      box-shadow: 0 0 0 3px var(--color-danger-wash);
    }

    @media (max-width: 640px) {
      .auth-card { padding: 1.75rem 1.5rem 1.5rem; border-radius: var(--radius-lg); }
      .auth-title { font-size: 1.4rem; }
    }
  </style>

  <script>
    const form = document.getElementById('regForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const stateBox = document.getElementById('stateBox')!;
    const nameInput = document.getElementById('regName') as HTMLInputElement;
    const nimInput = document.getElementById('regNim') as HTMLInputElement;
    const emailInput = document.getElementById('regEmail') as HTMLInputElement;
    const passwordInput = document.getElementById('regPassword') as HTMLInputElement;
    const nameError = document.getElementById('nameError')!;
    const nimError = document.getElementById('nimError')!;
    const emailError = document.getElementById('emailError')!;
    const passwordError = document.getElementById('passwordError')!;

    function showState(msg: string, type: 'error' | 'success' | 'warning' = 'error') {
      stateBox.textContent = msg;
      stateBox.className = `state-box state-box--${type}`;
      if (type === 'success') {
        setTimeout(() => { stateBox.className = 'state-box hidden'; }, 5000);
      }
    }

    function clearFieldErrors() {
      [nameError, nimError, emailError, passwordError].forEach(el => { el.textContent = ''; });
      [nameInput, nimInput, emailInput, passwordInput].forEach(el => { el.classList.remove('input-error'); });
    }

    function validateFields(): boolean {
      clearFieldErrors();
      let valid = true;

      if (!nameInput.value.trim()) {
        nameError.textContent = 'Full name is required';
        nameInput.classList.add('input-error');
        valid = false;
      }

      const nim = nimInput.value.trim();
      if (!nim) {
        nimError.textContent = 'NIM is required';
        nimInput.classList.add('input-error');
        valid = false;
      } else if (!/^\d{15}$/.test(nim)) {
        nimError.textContent = 'NIM must be exactly 15 digits';
        nimInput.classList.add('input-error');
        valid = false;
      }

      const email = emailInput.value.trim();
      if (!email) {
        emailError.textContent = 'Email is required';
        emailInput.classList.add('input-error');
        valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailError.textContent = 'Enter a valid email address';
        emailInput.classList.add('input-error');
        valid = false;
      }

      if (!passwordInput.value) {
        passwordError.textContent = 'Password is required';
        passwordInput.classList.add('input-error');
        valid = false;
      } else if (passwordInput.value.length < 8) {
        passwordError.textContent = 'Password must be at least 8 characters';
        passwordInput.classList.add('input-error');
        valid = false;
      }

      return valid;
    }

    [nameInput, nimInput, emailInput, passwordInput].forEach(input => {
      input.addEventListener('input', () => {
        input.classList.remove('input-error');
        const errorMap: Record<string, HTMLElement> = {
          regName: nameError, regNim: nimError, regEmail: emailError, regPassword: passwordError
        };
        const errorEl = errorMap[input.id];
        if (errorEl) errorEl.textContent = '';
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      stateBox.className = 'state-box hidden';

      if (!validateFields()) {
        const firstError = form.querySelector('.input-error') as HTMLElement;
        firstError?.focus();
        return;
      }

      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.innerHTML = '<span class="btn-spinner"></span> Creating account…';

      const fd = new FormData(form);
      const res = await fetch('/api/v1/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fullName: fd.get('fullName'),
          nim: fd.get('nim'),
          email: fd.get('email'),
          password: fd.get('password')
        })
      });
      const data = await res.json();

      if (!data.success) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        showState(data.message || 'Registration failed. Please try again.', 'error');
        return;
      }

      showState('Account created successfully. Redirecting to login…', 'success');
      setTimeout(() => { window.location.href = '/login'; }, 1200);
    });
  </script>
</Layout>
