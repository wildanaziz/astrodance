---
import Layout from '../../layouts/Layout.astro';
import { pageAuthGuard } from '../../shared/middleware/authGuard';
import { db } from '../../shared/config/db';
import { attendanceRecords, attendanceSessions, classes } from '../../shared/config/schema';
import { eq } from 'drizzle-orm';

const result = await pageAuthGuard(Astro, 'student');
if (result instanceof Response) return result;
const user = result;

const history = await db.select({
  id: attendanceRecords.id,
  mode: attendanceRecords.mode,
  submittedAt: attendanceRecords.submittedAt,
  sessionName: attendanceSessions.name,
  className: classes.name
}).from(attendanceRecords)
  .innerJoin(attendanceSessions, eq(attendanceRecords.sessionId, attendanceSessions.id))
  .innerJoin(classes, eq(attendanceSessions.classId, classes.id))
  .where(eq(attendanceRecords.studentId, user.sub))
  .orderBy(attendanceRecords.submittedAt);

const totalCount = history.length;
const inPersonCount = history.filter(h => h.mode === 'luring').length;
const onlineCount = history.filter(h => h.mode === 'daring').length;
const uniqueClasses = new Set(history.map(h => h.className)).size;

const reversed = history.slice().reverse();
---
<Layout title="Attendance History" role="student">

  <div class="anim-fade-up" style="margin-bottom:2.25rem">
    <a href="/student/dashboard" class="btn btn-ghost btn-sm" style="margin-bottom:0.85rem;padding-left:0">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="10 13 5 8 10 3"/></svg>
      Back to Dashboard
    </a>
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem">
      <div>
        <p style="font-size:0.75rem;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-accent);margin-bottom:0.4rem">Student Portal</p>
        <h1 style="font-family:var(--font-display);font-size:2.25rem;letter-spacing:-0.02em;line-height:1.1;color:var(--color-text)">Attendance History</h1>
      </div>
      {totalCount > 0 && (
        <span class="badge badge-accent" style="margin-top:0.35rem;font-size:0.8125rem;padding:0.3rem 0.75rem">{totalCount} record{totalCount !== 1 ? 's' : ''}</span>
      )}
    </div>
  </div>

  {totalCount > 0 && (
    <div class="stats-grid anim-fade-up" style="animation-delay:0.05s;margin-bottom:2.75rem">
      <div class="stat-card">
        <div class="stat-icon" style="background:var(--color-accent-wash);color:var(--color-accent)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
          <p class="stat-value">{totalCount}</p>
          <p class="stat-label">Total Records</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:var(--color-success-wash);color:var(--color-success)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div>
          <p class="stat-value" style="color:var(--color-success)">{inPersonCount}</p>
          <p class="stat-label">In-Person</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:var(--color-accent-wash);color:var(--color-accent)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <div>
          <p class="stat-value" style="color:var(--color-accent)">{onlineCount}</p>
          <p class="stat-label">Online</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:var(--color-warning-wash);color:var(--color-warning)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <div>
          <p class="stat-value" style="color:var(--color-warning)">{uniqueClasses}</p>
          <p class="stat-label">Classes</p>
        </div>
      </div>
    </div>
  )}

  <div class="anim-fade-up" style="animation-delay:0.1s">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
      <h2 class="section-heading">Records</h2>
      <div class="filter-tabs" role="tablist" aria-label="Filter attendance records">
        <button class="filter-tab active" role="tab" aria-selected="true" data-filter="all" onclick="filterRecords('all', this)">All</button>
        <button class="filter-tab" role="tab" aria-selected="false" data-filter="luring" onclick="filterRecords('luring', this)">In-Person</button>
        <button class="filter-tab" role="tab" aria-selected="false" data-filter="daring" onclick="filterRecords('daring', this)">Online</button>
      </div>
    </div>

    {history.length === 0 && (
      <div class="card" style="padding:4rem 2rem;text-align:center">
        <div style="width:60px;height:60px;border-radius:50%;background:var(--color-bg);display:inline-flex;align-items:center;justify-content:center;margin-bottom:1.1rem">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted-light)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <p style="font-weight:600;color:var(--color-text);margin-bottom:0.35rem;font-size:1.05rem">No attendance history yet</p>
        <p style="font-size:0.875rem;color:var(--color-muted);max-width:340px;margin:0 auto 1.25rem">Your records will appear here once you submit attendance to a session.</p>
        <a href="/student/dashboard" class="btn btn-primary">Go to Dashboard</a>
      </div>
    )}

    {history.length > 0 && (
      <div id="recordsList" style="display:grid;gap:0.5rem">
        {reversed.map(r => {
          const dateStr = new Date(r.submittedAt).toLocaleString(undefined, {
            month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit'
          });
          const dayStr = new Date(r.submittedAt).toLocaleString(undefined, {
            weekday: 'short', month: 'short', day: 'numeric'
          });
          const timeStr = new Date(r.submittedAt).toLocaleString(undefined, {
            hour: '2-digit', minute: '2-digit'
          });
          const isLuring = r.mode === 'luring';
          return (
            <div class="record-card" data-mode={r.mode}>
              <div class="record-date">
                <span class="record-day">{dayStr}</span>
                <span class="record-time">{timeStr}</span>
              </div>
              <div class="record-divider">
                <div class="record-dot" style={isLuring ? 'background:var(--color-success)' : 'background:var(--color-accent)'}></div>
              </div>
              <div class="record-content">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.2rem">
                  <h3 class="record-class">{r.className}</h3>
                  <span class="badge" style={isLuring ? 'background:var(--color-success-wash);color:#065f46' : 'background:var(--color-accent-wash);color:#4338ca'}>
                    {isLuring ? 'In-Person' : 'Online'}
                  </span>
                </div>
                <p class="record-session">{r.sessionName || 'Session'}</p>
              </div>
              <span class="record-timestamp">{dateStr}</span>
            </div>
          );
        })}
      </div>
    )}
  </div>

  <style>
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }
    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .stat-card {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding: 1.1rem 1.25rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    .stat-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--color-border-strong);
    }
    .stat-icon {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .stat-value {
      font-family: var(--font-display);
      font-size: 1.6rem;
      line-height: 1;
      color: var(--color-text);
      margin-bottom: 0.15rem;
      font-variant-numeric: tabular-nums;
    }
    .stat-label {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--color-muted);
      letter-spacing: 0.01em;
    }

    .filter-tabs {
      display: flex;
      gap: 0.25rem;
      padding: 0.25rem;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
    }
    .filter-tab {
      padding: 0.4rem 0.85rem;
      border: none;
      background: transparent;
      border-radius: var(--radius-xs);
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--color-muted);
      cursor: pointer;
      transition: background-color 0.15s, color 0.15s;
      font-family: var(--font-body);
    }
    .filter-tab:hover {
      color: var(--color-text);
    }
    .filter-tab.active {
      background: var(--color-surface);
      color: var(--color-text);
      box-shadow: var(--shadow-sm);
    }

    .record-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    .record-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--color-border-strong);
    }
    .record-card.hidden {
      display: none;
    }

    .record-date {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 72px;
      flex-shrink: 0;
    }
    .record-day {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text);
      white-space: nowrap;
    }
    .record-time {
      font-size: 0.6875rem;
      color: var(--color-muted-light);
      margin-top: 0.1rem;
    }

    .record-divider {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
    }
    .record-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .record-content {
      flex: 1;
      min-width: 0;
    }
    .record-class {
      font-weight: 600;
      font-size: 0.9375rem;
      color: var(--color-text);
    }
    .record-session {
      font-size: 0.8125rem;
      color: var(--color-muted);
      margin-top: 0.1rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .record-timestamp {
      font-size: 0.75rem;
      color: var(--color-muted-light);
      white-space: nowrap;
      flex-shrink: 0;
    }

    @media (max-width: 640px) {
      .stat-card { padding: 0.9rem 1rem; gap: 0.65rem; }
      .stat-icon { width: 36px; height: 36px; }
      .stat-icon svg { width: 15px; height: 15px; }
      .stat-value { font-size: 1.3rem; }
      .stat-label { font-size: 0.6875rem; }

      .record-card {
        flex-wrap: wrap;
        gap: 0.65rem;
        padding: 0.9rem 1rem;
      }
      .record-date { min-width: 60px; }
      .record-timestamp {
        width: 100%;
        padding-left: calc(60px + 10px + 1.3rem);
        margin-top: -0.25rem;
      }
    }
  </style>

  <script>
    window.filterRecords = (mode, btn) => {
      document.querySelectorAll('.filter-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      document.querySelectorAll('.record-card').forEach(card => {
        if (mode === 'all' || card.dataset.mode === mode) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    };
  </script>

</Layout>
