---
import Layout from '../../layouts/Layout.astro';
import AttendanceModal from '../../components/student/AttendanceModal.astro';
import EnrollModal from '../../components/student/EnrollModal.astro';
import SuccessModal from '../../components/student/SuccessModal.astro';
import { pageAuthGuard } from '../../shared/middleware/authGuard';
import { ClassService } from '../../modules/class/application/classService';
import { ClassRepository } from '../../modules/class/infrastructure/classRepository';
import { AttendanceService } from '../../modules/attendance/application/attendanceService';
import { AttendanceRepository } from '../../modules/attendance/infrastructure/attendanceRepository';
import { db } from '../../shared/config/db';
import { attendanceRecords, attendanceSessions, classes } from '../../shared/config/schema';
import { eq } from 'drizzle-orm';

const result = await pageAuthGuard(Astro, 'student');
if (result instanceof Response) return result;
const user = result;

const classService = new ClassService(new ClassRepository());
const enrolledClasses = await classService.listStudentClasses(user.sub);

const allClasses = await db.select({
  id: classes.id,
  name: classes.name,
  description: classes.description
}).from(classes);

const attendanceService = new AttendanceService(new AttendanceRepository());
const history = await db.select({
  id: attendanceRecords.id,
  sessionId: attendanceRecords.sessionId,
  mode: attendanceRecords.mode,
  submittedAt: attendanceRecords.submittedAt,
  sessionName: attendanceSessions.name,
  className: classes.name
}).from(attendanceRecords)
  .innerJoin(attendanceSessions, eq(attendanceRecords.sessionId, attendanceSessions.id))
  .innerJoin(classes, eq(attendanceSessions.classId, classes.id))
  .where(eq(attendanceRecords.studentId, user.sub))
  .orderBy(attendanceRecords.submittedAt);

const attendedCount = history.length;
const inPersonCount = history.filter(h => h.mode === 'luring').length;
const onlineCount = history.filter(h => h.mode === 'daring').length;
---
<Layout title="Student Dashboard" role="student">

  <div class="anim-fade-up" style="margin-bottom:2.25rem">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem">
      <div>
        <p style="font-size:0.75rem;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-accent);margin-bottom:0.4rem">Student Portal</p>
        <h1 style="font-family:var(--font-display);font-size:2.25rem;letter-spacing:-0.02em;line-height:1.1;color:var(--color-text)">Welcome back</h1>
      </div>
      <button class="btn btn-primary" onclick="openEnrollModal()">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3v10M3 8h10"/></svg>
        Enroll Class
      </button>
    </div>
  </div>

  // stats
  <div class="stats-grid anim-fade-up" style="animation-delay:0.05s;margin-bottom:2.75rem">
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--color-accent-wash);color:var(--color-accent)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <div>
        <p class="stat-value">{attendedCount}</p>
        <p class="stat-label">Total Attendance</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--color-success-wash);color:var(--color-success)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </div>
      <div>
        <p class="stat-value" style="color:var(--color-success)">{inPersonCount}</p>
        <p class="stat-label">In-Person</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--color-accent-wash);color:var(--color-accent)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      </div>
      <div>
        <p class="stat-value" style="color:var(--color-accent)">{onlineCount}</p>
        <p class="stat-label">Online</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--color-warning-wash);color:var(--color-warning)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <p class="stat-value" style="color:var(--color-warning)" id="statOpenSessions">-</p>
        <p class="stat-label">Open Sessions</p>
      </div>
    </div>
  </div>

  <div class="anim-fade-up" style="animation-delay:0.1s;margin-bottom:2rem" id="activeSessionsSection">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <div>
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.2rem">
          <h2 class="section-heading">Active Sessions</h2>
          <span class="badge badge-warning" id="liveBadge" style="display:none"><span class="live-dot"></span>Live</span>
        </div>
        <p style="font-size:0.8125rem;color:var(--color-muted)">Submit your attendance for open sessions</p>
      </div>
      {history.length > 0 && (
        <a href="/student/attendance" class="btn btn-ghost btn-sm">View history &rarr;</a>
      )}
    </div>
    <div id="activeSessionsList">
      <div class="card" style="padding:3.5rem 2rem;text-align:center">
        <div style="width:56px;height:56px;border-radius:50%;background:var(--color-bg);display:inline-flex;align-items:center;justify-content:center;margin-bottom:1rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted-light)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <p style="font-weight:600;color:var(--color-text);margin-bottom:0.3rem;font-size:1rem">Loading sessions...</p>
      </div>
    </div>
  </div>

  <AttendanceModal />
  <EnrollModal availableClasses={allClasses} enrolledIds={enrolledClasses.map(c => c.id)} />
  <SuccessModal />

  <style>
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }
    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .stat-card {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding: 1.1rem 1.25rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    .stat-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--color-border-strong);
    }
    .stat-icon {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .stat-value {
      font-family: var(--font-display);
      font-size: 1.6rem;
      line-height: 1;
      color: var(--color-text);
      margin-bottom: 0.15rem;
      font-variant-numeric: tabular-nums;
    }
    .stat-label {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--color-muted);
      letter-spacing: 0.01em;
    }

    .session-card {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 1.25rem 1.5rem;
      padding-left: 1.25rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    .session-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--color-border-strong);
    }
    .session-indicator {
      width: 4px;
      height: 48px;
      border-radius: 4px;
      background: var(--color-warning);
      flex-shrink: 0;
      animation: pulse-bar 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse-bar {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    @media (max-width: 768px) {
      .stat-card { padding: 0.9rem 1rem; gap: 0.65rem; }
      .stat-icon { width: 36px; height: 36px; }
      .stat-value { font-size: 1.35rem; }
      .session-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.85rem;
        padding: 1.1rem 1.25rem;
      }
      .session-card .btn { width: 100%; }
    }

    @media (max-width: 640px) {
      .stat-card { padding: 0.8rem 0.9rem; gap: 0.55rem; }
      .stat-icon { width: 32px; height: 32px; }
      .stat-icon svg { width: 15px; height: 15px; }
      .stat-value { font-size: 1.2rem; }
      .stat-label { font-size: 0.6875rem; }
    }
  </style>

  <script>
    (function pollActiveSessions() {
      fetch('/api/v1/student/sessions/active')
        .then(function(res) { return res.json(); })
        .then(function(json) {
          if (!json.success) return;

          var sessions = json.data;
          var listEl = document.getElementById('activeSessionsList');
          var statEl = document.getElementById('statOpenSessions');
          var badgeEl = document.getElementById('liveBadge');

          if (statEl) statEl.textContent = String(sessions.length);

          if (sessions.length === 0) {
            if (badgeEl) badgeEl.style.display = 'none';
            if (listEl) listEl.innerHTML = '<div class="card" style="padding:3.5rem 2rem;text-align:center"><div style="width:56px;height:56px;border-radius:50%;background:var(--color-bg);display:inline-flex;align-items:center;justify-content:center;margin-bottom:1rem"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted-light)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><p style="font-weight:600;color:var(--color-text);margin-bottom:0.3rem;font-size:1rem">No active sessions right now</p><p style="font-size:0.875rem;color:var(--color-muted);max-width:320px;margin:0 auto">Sessions will appear here when your instructor opens them during class time.</p></div>';
            return;
          }

          if (badgeEl) badgeEl.style.display = 'inline-flex';
          if (listEl) {
            listEl.innerHTML = '<div style="display:grid;gap:0.75rem">' + sessions.map(function(s) {
              var endTimeStr = new Date(s.endTime).toLocaleString(undefined, {
                month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
              });
              var sessionName = s.name || 'Session';
              var sid = s.id.replace(/'/g, "\\'");
              return '<div class="session-card">'
                + '<div class="session-indicator"></div>'
                + '<div style="flex:1;min-width:0">'
                + '<div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem">'
                + '<span class="badge badge-warning" style="font-size:0.6875rem">Open now</span>'
                + '<span style="font-size:0.75rem;color:var(--color-muted-light)">Closes ' + endTimeStr + '</span>'
                + '</div>'
                + '<h3 style="font-weight:700;font-size:1.05rem;color:var(--color-text);margin-bottom:0.15rem">' + (s.className || 'Class') + '</h3>'
                + '<p style="font-size:0.8125rem;color:var(--color-muted)">' + sessionName + '</p>'
                + '</div>'
                + '<button class="btn btn-primary" onclick="openAttModal(\'' + sid + '\')">'
                + '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>'
                + ' Submit Attendance'
                + '</button>'
                + '</div>';
            }).join('') + '</div>';
          }
        })
        .catch(function() {})
        .finally(function() {
          setTimeout(pollActiveSessions, 15000);
        });
    })();
  </script>

</Layout>
